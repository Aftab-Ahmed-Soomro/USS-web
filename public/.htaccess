# Hostinger .htaccess for Next.js Static Export (output: "export")

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (Optional - recommended for Hostinger SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect explicit /index.html to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html\s [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 3. Redirect explicit .html extension requests to clean URL (e.g. /about.html -> /about)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html\s [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4. If requested path + .html exists as a file, serve that .html file
  # (Fixes sub-path refresh 404 error when folder exists alongside .html file)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 5. If actual file exists, serve it directly (CSS, JS, images, SVG, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 6. If actual directory with index.html exists, serve index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 7. Custom 404 Error Page
  ErrorDocument 404 /404.html
</IfModule>
